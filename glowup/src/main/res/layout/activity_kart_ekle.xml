<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jacket_khaki"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Text.Baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Yeni Tekrar Kartı" />

        <TextView
            style="@style/Text.Govde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Kategori" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/kategoriBilissel"
                style="@style/Text.Govde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/secim_durumu"
                android:text="Bilişsel" />

            <TextView
                android:id="@+id/kategoriEntelektuel"
                style="@style/Text.Govde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/secim_durumu"
                android:text="Entelektüel" />
        </LinearLayout>

        <TextView
            style="@style/Text.Govde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soru" />

        <EditText
            android:id="@+id/soruGirisi"
            style="@style/Text.Govde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="1"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@drawable/kart_focus_selector"
            android:padding="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/Text.Govde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cevap" />

        <EditText
            android:id="@+id/cevapGirisi"
            style="@style/Text.Govde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="1"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@drawable/kart_focus_selector"
            android:padding="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/kaydetButonu"
            style="@style/Text.Govde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/kart_focus_selector"
            android:text="Kaydet" />

    </LinearLayout>
</ScrollView>
