<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jacket_khaki"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/anaSoru"
            style="@style/Text.Baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/ana_soru" />

        <!-- Tek tuşla tetiklenen ana giriş — her zaman ekranın ilk odak noktası. -->
        <TextView
            android:id="@+id/buyukOneriButonu"
            style="@style/Text.Baslik"
            android:textSize="20sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center"
            android:background="@drawable/kart_focus_selector"
            android:text="🔎  Şimdi Ne Yapsam" />

        <TextView
            android:id="@+id/gunlukOzetMetni"
            style="@style/Text.Istatistik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            style="@style/Text.Govde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="Alanlar" />

        <LinearLayout
            android:id="@+id/kategoriListesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Kategori kartları ve Tekrar Kartları / İstatistikler girişleri
                 burada programatik olarak eklenir (bkz. MainActivity). -->

        </LinearLayout>
    </LinearLayout>
</ScrollView>
