<?xml version="1.0" encoding="utf-8"?>
<!-- Süre/mod seçim öğeleri: seçili (activated), odaklı (focused) ve varsayılan durum. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tie_burgundy" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shirt_offwhite" />
            <stroke android:width="3dp" android:color="@color/eye_lavender" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shirt_offwhite_dim" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
